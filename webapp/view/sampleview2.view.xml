<mvc:View
    controllerName="com.samplescreen.controller.sampleview2"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    displayBlock="true">

    <Page>

        <customHeader>
            <Toolbar>

                <Button
                    text="Back"
                    type="Back"
                    press="onBack" />

                <ToolbarSpacer />

                <Title text="Customer Contract Creation" />

                <ToolbarSpacer />

                <Button icon="sap-icon://home" type="Emphasized" />
                <Button icon="sap-icon://document" type="Emphasized" />
                <Button icon="sap-icon://edit" type="Emphasized" />
                <Button
                    icon="sap-icon://action"
                    type="Emphasized"
                    press="onAction" />

            </Toolbar>
        </customHeader>

        <content>

            <!-- TOP BUTTONS -->

            <HBox
                justifyContent="Center"
                width="100%"
                class="sapUiMediumMarginTop">

                <Button
                    text="Contract"
                    type="Emphasized"
                    press="onContractPress" />

                <Button
                    text="Line Item 1"
                    type="Emphasized"
                    class="sapUiSmallMarginBegin"
                    press="onLineItem1Press" />

                <Button
                    text="Line Item 2"
                    type="Emphasized"
                    class="sapUiSmallMarginBegin"
                    press="onLineItem2Press" />

                <Button
                    text="Line Item 3"
                    type="Emphasized"
                    class="sapUiSmallMarginBegin" />

                <Button
                    text="Line Item 4"
                    type="Emphasized"
                    class="sapUiSmallMarginBegin" />

                <Button
                    text="Line Item 5"
                    type="Emphasized"
                    class="sapUiSmallMarginBegin" />

            </HBox>

            <!-- CONTRACT SIMPLE FORM -->

            <VBox visible="{viewModel>/showContract}">

                <l:Grid
                    defaultSpan="L6 M6 S12"
                    class="sapUiSmallMarginTop">

                    <!-- LEFT FORM -->

                    <f:SimpleForm layout="ResponsiveGridLayout">

                        <Label text="Valid From" required="true" />
                        <DatePicker value="6/11/2025" />

                        <Label text="Sold To Name" required="true" />
                        <Input />

                        <Label text="Sold To Address" />
                        <Input />

                        <Label text="Sold To State" />
                        <Select />

                        <Label text="Payer Number" />
                        <Input />

                        <Label text="Ship To / Job Name" required="true" />
                        <Input />

                        <Label text="PO Number" required="true" />
                        <Input />

                        <Label text="Ship To Address" />
                        <Input />

                        <Label text="Ship To State" required="true" />
                        <Select />

                    </f:SimpleForm>

                    <!-- RIGHT FORM -->

                    <f:SimpleForm layout="ResponsiveGridLayout">

                        <Label text="Valid To" required="true" />
                        <DatePicker value="12/31/2025" />

                        <Label text="Sold To Number" />
                        <Input />

                        <Label text="Sold To City" />
                        <Input />

                        <Label text="Sold To Zip Code" />
                        <Input />

                        <Label text="Bill To Number" />
                        <Input />

                        <Label text="Plan Name" />
                        <Select />

                        <Label text="Job Number" />
                        <Input />

                        <Label text="Ship To City" />
                        <Input />

                        <Label text="Ship To Zip Code" />
                        <Input />

                    </f:SimpleForm>

                </l:Grid>

            </VBox>

            <!-- TABLE SECTION -->

            <VBox visible="{viewModel>/showTable}">

                <Table
                    inset="false"
                    items="{/salesOrders}"
                    class="sapUiMediumMarginTop">

                    <columns>

                        <Column>
                            <Text text="Order ID" />
                        </Column>

                        <Column>
                            <Text text="Customer" />
                        </Column>

                        <Column>
                            <Text text="Material" />
                        </Column>

                        <Column>
                            <Text text="Quantity" />
                        </Column>

                        <Column>
                            <Text text="Amount" />
                        </Column>

                    </columns>

                    <items>

                        <ColumnListItem>

                            <cells>

                                <Text text="{OrderId}" />
                                <Text text="{Customer}" />
                                <Text text="{Material}" />
                                <Text text="{Quantity}" />
                                <Text text="{Amount}" />

                            </cells>

                        </ColumnListItem>

                    </items>

                </Table>

            </VBox>

            <!-- LIST REPORT SECTION -->

            <VBox visible="{viewModel>/showList}">

                <List
                    items="{/salesOrders}"
                    class="sapUiMediumMarginTop">

                    <StandardListItem
                        title="{Customer}"
                        description="{Material}"
                        info="{Amount}" />

                </List>

            </VBox>

            <!-- FOOTER BUTTONS -->

            <Toolbar>

                <Button text="Save" type="Reject" />

                <ToolbarSpacer />

                <Button
                    text="Save As Template"
                    type="Reject" />

                <ToolbarSpacer />

                <Button
                    text="Preview"
                    type="Reject" />

                <Button
                    text="Submit to Admin"
                    enabled="false" />

                <Button
                    text="Submit To Specialist"
                    type="Reject" />

            </Toolbar>

        </content>

    </Page>

</mvc:View>